###############################################################################
# Pi Engine Configuration
#
# Copy this file to:
#   config.toml
#
# Values provided on the command line override values in this file.
###############################################################################

###############################################################################
# Precision
###############################################################################

# Number of decimal digits to calculate.
digits = 1000000

###############################################################################
# Threading
###############################################################################

# Number of worker threads.
# 0 = Automatically use all available hardware threads.
threads = 0

###############################################################################
# Checkpoint
###############################################################################

# Enable periodic checkpoints.
checkpoint = true

# Save checkpoint every N seconds.
checkpoint_interval = 300

# Directory containing durable checkpoint blocks and manifests.
checkpoint_directory = "checkpoints"

# Directory receiving rejected or corrupt checkpoint files.
checkpoint_quarantine_directory = "checkpoint-quarantine"

###############################################################################
# Memory
###############################################################################

# Reserved setting. The current runtime loads this value but does not yet
# apply a Huge Pages allocation policy.
huge_pages = true

###############################################################################
# Out-of-Core Storage
###############################################################################

# Enable disk-backed storage for large computations.
out_of_core = true

# Compression algorithm: "none" or "lz4".
compression = "lz4"

# Directory for out-of-core chunks and index metadata.
storage_directory = "storage"

# Resident memory budget and target chunk size in bytes.
# The target chunk size must not exceed the memory budget.
storage_memory_budget_bytes = 536870912
storage_target_chunk_size_bytes = 67108864

# Maximum number of concurrent storage I/O operations.
storage_max_concurrent_io = 1

###############################################################################
# Progress
###############################################################################

# Progress update interval (milliseconds).
progress = true

progress_interval = 500

# Progress output format: "text" or "json".
progress_format = "text"

###############################################################################
# Output
###############################################################################

# Output file.
output = "pi.txt"

###############################################################################
# Final Verification
###############################################################################

# Verify the completed decimal output.
verification = true

# Number of deterministic BBP samples (1-32).
bbp_samples = 8

# Optional manifest path. Empty uses "<output>.verify".
verification_manifest = ""

###############################################################################
# Resume
###############################################################################

# Automatically resume from the latest checkpoint if available.
resume = true
